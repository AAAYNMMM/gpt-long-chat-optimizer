{
  "manifest_version": 3,
  "name": "GPT 长聊加速器",
  "version": "0.2.0",
  "description": "通过浏览器原生的离屏渲染跳过机制，缓解 ChatGPT 超长会话的滚动、输入和渲染卡顿。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GPT 长聊加速器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js",
        "live-turn-protection.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
